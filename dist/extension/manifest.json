{
  "manifest_version": 3,
  "name": "Stream Comments",
  "version": "0.1.0",
  "description": "Time-bound comments on Netflix and Hulu: SoundCloud-style timeline + TikTok-style top comments.",
  "icons": {
    "16": "icons/16.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "action": {
    "default_title": "Netflix Comments",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/16.png",
      "48": "icons/48.png",
      "128": "icons/128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://*.workers.dev/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "*://*.netflix.com/*",
        "*://*.hulu.com/*"
      ],
      "js": [
        "content/util.js",
        "content/sites.js",
        "content/styles.js",
        "content/store.js",
        "content/ui.js",
        "content/main.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
